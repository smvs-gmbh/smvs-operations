# Public SMVS Connect only; no database, SendGrid or encryption keys here.
CONNECT_ENVIRONMENT=production
CONNECT_PUBLIC_ORIGIN=https://connect.smvs-gmbh.ch
CONNECT_INTERNAL_ORIGIN=https://10.100.32.195:8443
CONNECT_API_SECRET=GENERATE_DEDICATED_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CONNECT_TALLY_SIGNING_SECRET=EXACT_SIGNING_SECRET_FROM_TALLY
# Read-only CA certificate for the private API; never disable certificate checks.
CONNECT_CA_FILE=/PRIVATE/SERVICE/DIRECTORY/certs/registration-ca.pem
