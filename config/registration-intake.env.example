# Separate public intake only. Copy as .env.registration-intake in its own deployment.
# NEVER copy the Operations .env, NMVS credentials or core DB access into this service.
REGISTRATION_ENVIRONMENT=production
REGISTRATION_DATABASE_URL=mysql+pymysql://REGISTRATION_USER:URL_ENCODED_PASSWORD@PRIVATE_DB_HOST/smvs_registration?ssl_ca=/path/to/ca.pem
REGISTRATION_PUBLIC_ORIGIN=https://CHOOSE_PUBLIC_REGISTRATION_HOST
REGISTRATION_ENCRYPTION_KEY=GENERATE_A_DEDICATED_FERNET_KEY
REGISTRATION_EXCHANGE_SECRET=GENERATE_AN_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TALLY_REGISTRATION_SIGNING_SECRET=CONFIGURE_THE_TALLY_SIGNING_SECRET_AT_LEAST_32_CHARACTERS
REGISTRATION_SECURITY_TTL_DAYS=7
SENDGRID_API_KEY=CONFIGURE_LOCALLY
REGISTRATION_MAIL_TEMPLATE=d-3cae560da6c644aa92b54d4e170b059b
# Verified registration sender.
REGISTRATION_MAIL_FROM=office@smvs-gmbh.ch
# Exact variable used by the existing dynamic template.
REGISTRATION_MAIL_LINK_FIELD=confirmation_link
